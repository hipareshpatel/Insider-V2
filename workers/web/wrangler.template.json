{
  "name": "disclo-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "assets": { "directory": "./site", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "vars": { "ENVIRONMENT": "production", "SITE_OFFLINE": "1" },
  "ratelimits": [{ "name": "RATE", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "d1_databases": [
    { "binding": "DB_MARKET", "database_name": "disclo-market", "database_id": "${market}" },
    { "binding": "DB_FILINGS", "database_name": "disclo-filings", "database_id": "${filings}" },
    { "binding": "DB_APP", "database_name": "disclo-app", "database_id": "${app}" }
  ]
}
