{
  "name": "disclo-prefetch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 60000 },
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "ENVIRONMENT": "production", "PARALLEL": "16", "PER_RUN": "640", "FOCUS_INDICES": "NIFTY 50,NIFTY NEXT 50,NIFTY MIDCAP 150" },
  "d1_databases": [{ "binding": "DB_FILINGS", "database_name": "disclo-filings", "database_id": "${filings}" }, { "binding": "DB_MARKET", "database_name": "disclo-market", "database_id": "${market}" }],
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "disclo-raw" }]
}
